  "info": {
    "description": "Sistema Inteligente para Optimización de Producción Piscícola de Trucha. Las decisiones siguen siendo humanas: el sistema automatiza detección, registro y cálculo.\n\nAutenticación: `POST /api/auth/login` devuelve un JWT para `Authorization: Bearer`. Errores: `{\"error\", \"detalle\", \"campo\"}`.",
    "title": "TruchaSmart API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "description": "Valida credenciales y devuelve un JWT para usar como `Authorization: Bearer`.",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenSalida"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            },
            "description": "No autenticado o credenciales inválidas"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            },
            "description": "El rol no tiene permiso"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            },
            "description": "Recurso no encontrado"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            },
            "description": "Conflicto con el estado actual"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            },
            "description": "Datos inválidos"
          }
        },
        "summary": "Login",
        "tags": [
          "autenticación"
        ]
      }
    },
