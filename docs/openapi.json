{
  "components": {
    "schemas": {
      "EstadoSalud": {
        "properties": {
          "estado": {
            "title": "Estado",
            "type": "string"
          },
          "servicio": {
            "title": "Servicio",
            "type": "string"
          }
        },
        "required": [
          "estado",
          "servicio"
        ],
        "title": "EstadoSalud",
        "type": "object"
      },
      "LoginEntrada": {
        "properties": {
          "nombre_usuario": {
            "examples": [
              "operario"
            ],
            "title": "Nombre Usuario",
            "type": "string"
          },
          "password": {
            "examples": [
              "Oper123!"
            ],
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "nombre_usuario",
          "password"
        ],
        "title": "LoginEntrada",
        "type": "object"
      },
      "RespuestaError": {
        "properties": {
          "campo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Campo"
          },
          "detalle": {
            "title": "Detalle",
            "type": "string"
          },
          "error": {
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error",
          "detalle"
        ],
        "title": "RespuestaError",
        "type": "object"
      },
      "Rol": {
        "enum": [
          "ADMINISTRADOR",
          "PISCICULTOR",
          "OPERARIO"
        ],
        "title": "Rol",
        "type": "string"
      },
      "TokenSalida": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expira_en_segundos": {
            "title": "Expira En Segundos",
            "type": "integer"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "usuario": {
            "$ref": "#/components/schemas/UsuarioSalida"
          }
        },
        "required": [
          "access_token",
          "expira_en_segundos",
          "usuario"
        ],
        "title": "TokenSalida",
        "type": "object"
      },
      "UsuarioEntrada": {
        "properties": {
          "nombre_completo": {
            "title": "Nombre Completo",
            "type": "string"
          },
          "nombre_usuario": {
            "title": "Nombre Usuario",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "rol": {
            "$ref": "#/components/schemas/Rol"
          }
        },
        "required": [
          "nombre_usuario",
          "nombre_completo",
          "password",
          "rol"
        ],
        "title": "UsuarioEntrada",
        "type": "object"
      },
      "UsuarioSalida": {
        "properties": {
          "activo": {
            "title": "Activo",
            "type": "boolean"
          },
          "creado_en": {
            "format": "date-time",
            "title": "Creado En",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "nombre_completo": {
            "title": "Nombre Completo",
            "type": "string"
          },
          "nombre_usuario": {
            "title": "Nombre Usuario",
            "type": "string"
          },
          "rol": {
            "$ref": "#/components/schemas/Rol"
          }
        },
        "required": [
          "id",
          "nombre_usuario",
          "nombre_completo",
          "rol",
          "activo",
          "creado_en"
        ],
        "title": "UsuarioSalida",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Token JWT obtenido en /api/auth/login",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Sistema Inteligente para Optimización de Producción Piscícola de Trucha. Las decisiones siguen siendo humanas: el sistema automatiza detección, registro y cálculo.\n\nAutenticación: `POST /api/auth/login` devuelve un JWT para `Authorization: Bearer`. Errores: `{\"error\", \"detalle\", \"campo\"}`.",
    "title": "TruchaSmart API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "description": "Valida credenciales y devuelve un JWT para usar como `Authorization: Bearer`.",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenSalida"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            },
            "description": "No autenticado o credenciales inválidas"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            },
            "description": "El rol no tiene permiso"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            },
            "description": "Recurso no encontrado"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            },
            "description": "Conflicto con el estado actual"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            },
            "description": "Datos inválidos"
          }
        },
        "summary": "Login",
        "tags": [
          "autenticación"
        ]
      }
    },
