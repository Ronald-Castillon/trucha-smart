# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# Cadena de conexión SQLAlchemy.
#  - Desarrollo/pruebas locales: sqlite:///./truchasmart.db
#  - docker-compose (PostgreSQL): postgresql+psycopg://trucha:trucha@db:5432/truchasmart
DATABASE_URL=sqlite:///./truchasmart.db

# Clave para firmar los JWT (cambiar en cualquier entorno compartido).
# APP_ENV=produccion exige un JWT_SECRET propio de 32+ caracteres y activa la cookie Secure
APP_ENV=desarrollo
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRA_MINUTOS=480

# Rutas de configuración parametrizable (ADR-005).
UMBRALES_PATH=config/umbrales.yaml
ALIMENTACION_PATH=config/alimentacion.yaml

# Credenciales de PostgreSQL usadas por docker-compose.
POSTGRES_USER=trucha
POSTGRES_PASSWORD=trucha
POSTGRES_DB=truchasmart
